FROM python:3.11-slim

WORKDIR /app

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# Clone and install OpenSandbox server
RUN git clone https://github.com/alibaba/OpenSandbox.git /tmp/opensandbox && \
    cd /tmp/opensandbox/server && \
    uv pip install --system . && \
    cd / && rm -rf /tmp/opensandbox

# Copy configuration file
COPY config.toml /app/.sandbox.toml.example

EXPOSE 8080

CMD ["python", "-m", "src.main"]
