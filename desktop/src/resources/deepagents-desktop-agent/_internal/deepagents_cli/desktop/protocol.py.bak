"""Unix Socket 通信协议 - 桌面模式."""

import asyncio
import msgpack
import os
import sys
from pathlib import Path
from typing import Any

from langgraph.types import Command

from deepagents_cli.agent import create_cli_agent
from deepagents_cli.config import settings


class DesktopProtocol:
    """Desktop mode protocol using Unix Socket communication.

    This protocol handles communication between Electron desktop app and Python Agent
    via Unix Domain Socket with MessagePack encoding.
    """

    def __init__(self, socket_path: str, assistant_id: str = "desktop"):
        """Initialize the DesktopProtocol.

        Args:
            socket_path: Path to the Unix socket file
            assistant_id: Agent identifier for memory storage
        """
        self.socket_path = socket_path
        self.assistant_id = assistant_id
        self.agent = None
        self.composite_backend = None
        self.running = False

    async def start(self) -> None:
        """Start the socket client and connect to Electron."""
        # Check for test mode
        if os.getenv("DEEPAGENTS_TEST") == "1":
            await self._test_mode_handler()
            return

        # Normal mode: Create agent and handle connections
        await self._normal_mode_handler()

    async def _normal_mode_handler(self) -> None:
        """Normal mode handler with full agent capabilities."""
        # Log to home directory for better permissions
        import sys
        log_path = Path.home() / 'deepagents-desktop-python.log'
        log_file = open(log_path, 'w')
        sys.stderr = log_file

        # Log socket path for debugging
        log_file.write(f"Socket path: {self.socket_path}\n")
        log_file.write(f"Socket exists: {Path(self.socket_path).exists()}\n")
        log_file.flush()

        try:
            log_file.write("Starting agent creation...\n")
            log_file.flush()

            # Create the agent
            # Note: HITL support is being implemented. Long connection mode allows
            # the agent to pause execution and wait for user approval on tool calls.
            self.agent, self.composite_backend = create_cli_agent(
                model=settings.model_name or "claude-sonnet-4-5-20250929",
                assistant_id=self.assistant_id,
                tools=[],  # No extra tools for desktop mode
                sandbox=None,  # Local filesystem mode
                auto_approve=False,  # Enable HITL - wait for user approval on tools
                enable_memory=True,
                enable_skills=True,
                enable_shell=True,  # Enable shell execution
            )

            log_file.write("Agent created successfully\n")
            log_file.flush()
        except Exception as e:
            log_file.write(f"ERROR creating agent: {e}\n")
            log_file.flush()
            return

        self.running = True
        connection_count = 0
        while self.running:
            try:
                log_file.write(f"Attempting connection {connection_count}...\n")
                log_file.flush()
                reader, writer = await asyncio.open_unix_connection(self.socket_path)
                log_file.write(f"Connected! Handling connection...\n")
                log_file.flush()
                await self.handle_connection(reader, writer)
                connection_count += 1
            except (ConnectionRefusedError, FileNotFoundError):
                # Socket not ready yet, wait and retry
                log_file.write("Connection failed, retrying in 1s...\n")
                log_file.flush()
                await asyncio.sleep(1)
            except Exception as e:
                log_file.write(f"Connection error: {e}\n")
                log_file.flush()
                await asyncio.sleep(1)

    async def _test_mode_handler(self) -> None:
        """Test mode handler with simple ping-pong."""
        print(f"DesktopProtocol: Test mode - connecting to {self.socket_path}")
        self.running = True
        while self.running:
            try:
                reader, writer = await asyncio.open_unix_connection(self.socket_path)
                await self.handle_connection(reader, writer)
            except (ConnectionRefusedError, FileNotFoundError):
                await asyncio.sleep(1)
            except Exception as e:
                print(f"Connection error: {e}")
                await asyncio.sleep(1)

    async def handle_connection(self, reader: asyncio.StreamReader, writer: asyncio.StreamWriter) -> None:
        """Handle connection from Electron.

        Uses keep-alive mode: maintains connection for multiple requests.
        Supports interrupt/resume for HITL functionality.

        Args:
            reader: Stream reader for incoming data
            writer: Stream writer for outgoing data
        """
        # Create session state for this connection
        session_state = {
            'writer': writer,
            'thread_id': self.assistant_id,
            'status': 'idle',
            'pending_interrupt': None
        }

        log_file = open(Path.home() / 'deepagents-desktop-python.log', 'a')
        log_file.write(f"[Session] New connection established, thread_id: {session_state['thread_id']}\n")
        log_file.flush()

        try:
            # Message loop - keep connection alive
            while self.running:
                try:
                    # Read with timeout (for heartbeat)
                    length_data = await asyncio.wait_for(
                        reader.readexactly(4),
                        timeout=30.0
                    )
                    length = int.from_bytes(length_data, 'little')

                    # Read message body
                    message_data = await reader.readexactly(length)
                    message = msgpack.unpackb(message_data)

                    log_file.write(f"[Session] Received message: {message.get('method', 'unknown')}\n")
                    log_file.flush()

                    # Process request
                    response = await self.handle_request(message, session_state)

                    # Send response
                    if response:
                        response_data = msgpack.packb(response)
                        response_length = len(response_data).to_bytes(4, 'little')
                        writer.write(response_length + response_data)
                        await writer.drain()

                except asyncio.TimeoutError:
                    # Send heartbeat to keep connection alive
                    log_file.write("[Session] Heartbeat\n")
                    log_file.flush()
                    try:
                        heartbeat = msgpack.packb({'type': 'heartbeat'})
                        writer.write(len(heartbeat).to_bytes(4, 'little') + heartbeat)
                        await writer.drain()
                    except Exception:
                        break  # Connection broken

        except asyncio.IncompleteReadError:
            # Connection closed by client
            log_file.write("[Session] Connection closed by client\n")
            log_file.flush()
        except Exception as e:
            # Connection error
            log_file.write(f"[Session] Connection error: {e}\n")
            log_file.flush()
        finally:
            log_file.write("[Session] Closing connection\n")
            log_file.flush()
            log_file.close()
            try:
                writer.close()
                await writer.wait_closed()
            except Exception:
                pass

    async def handle_request(self, message: dict[str, Any], session_state: dict[str, Any]) -> dict[str, Any] | None:
        """Handle incoming request from Electron.

        Args:
            message: Request message with method and params
            session_state: Session state for this connection

        Returns:
            Response message, or None for no response (e.g., heartbeat)
        """
        request_type = message.get('method')

        # Handle heartbeat response (no reply needed)
        if request_type is None and 'type' in message:
            if message['type'] == 'heartbeat':
                return None

        # Test mode: simple ping-pong
        if os.getenv("DEEPAGENTS_TEST") == "1":
            if request_type == "ping":
                return {
                    'request_id': message.get('request_id'),
                    'status': 'success',
                    'data': {'pong': True}
                }
            return {
                'request_id': message.get('request_id'),
                'status': 'error',
                'error': {
                    'code': 'UNKNOWN_METHOD',
                    'message': f"Unknown method: {request_type}"
                }
            }

        # Normal mode: handle chat requests
        if request_type == "chat":
            return await self._handle_chat(message.get('request_id'), message.get('params', {}), session_state)

        # Handle list_skills request
        if request_type == "list_skills":
            return await self._handle_list_skills(message.get('request_id'))

        # Handle upload_skill request
        if request_type == "upload_skill":
            return await self._handle_upload_skill(message.get('request_id'), message.get('params', {}))

        # Handle tool_approval request (HITL user decision)
        if request_type == "tool_approval":
            return await self._handle_tool_approval(message.get('request_id'), message.get('params', {}), session_state)

        return {
            'request_id': message.get('request_id'),
            'status': 'error',
            'error': {
                'code': 'UNKNOWN_METHOD',
                'message': f"Unknown method: {request_type}"
            }
        }

    async def _handle_list_skills(self, request_id: str) -> dict[str, Any]:
        """Handle list_skills request.

        Args:
            request_id: Request identifier for response correlation

        Returns:
            Response with list of available skills
        """
        from pathlib import Path
        from deepagents_cli.skills.load import list_skills
        import os

        # Define skills directories
        user_skills_dir = Path.home() / '.deepagents' / 'skills'

        # Try to find project root (look for .deepagents directory)
        project_root = None
        current = Path.cwd()

        # If running from packaged app, search upward for project root
        # or use environment variable if set
        if 'DEEPAGENTS_PROJECT_ROOT' in os.environ:
            project_root = Path(os.environ['DEEPAGENTS_PROJECT_ROOT'])
        else:
            # Try searching upward for project root indicators
            # Need to search many levels when running from packaged app
            # (app bundle structure: .../DeepAgents.app/Contents/Resources/deepagents-cli)
            search_path = current
            for _ in range(10):  # Search up to 10 levels up
                if (search_path / '.deepagents').exists():
                    project_root = search_path
                    break
                if search_path == search_path.parent:  # Reached root
                    break
                search_path = search_path.parent

        if project_root:
            project_skills_dir = project_root / '.deepagents' / 'skills'
        else:
            # Fallback: use current directory
            project_skills_dir = Path.cwd() / '.deepagents' / 'skills'

        # Load skills from both directories
        skills = list_skills(
            user_skills_dir=user_skills_dir,
            project_skills_dir=project_skills_dir
        )

        # Convert to JSON-serializable format
        skills_list = [
            {
                'name': s['name'],
                'description': s['description'],
                'source': s['source'],
                'path': s['path']
            }
            for s in skills
        ]

        return {
            'request_id': request_id,
            'status': 'success',
            'data': {'skills': skills_list}
        }

    async def _handle_upload_skill(self, request_id: str, params: dict[str, Any]) -> dict[str, Any]:
        """Handle upload_skill request.

        Receives file contents as base64 and writes them to skills directory.
        Default: project skills (.deepagents/skills/)
        Optional: user skills (~/.deepagents/skills/)

        Args:
            request_id: Request identifier for response correlation
            params: Dictionary containing skill_name, files, and optional location

        Returns:
            Response with upload status
        """
        import base64
        import binascii
        from pathlib import Path

        # Open log file for debugging
        log_path = Path.home() / 'deepagents-desktop-python.log'
        log_file = open(log_path, 'a')

        skill_name = params.get('skill_name')
        files = params.get('files', [])

        if not skill_name:
            return {
                'request_id': request_id,
                'status': 'error',
                'error': {
                    'code': 'INVALID_PARAMS',
                    'message': 'skill_name is required'
                }
            }

        # Validate skill name format
        if not skill_name or not isinstance(skill_name, str):
            return {
                'request_id': request_id,
                'status': 'error',
                'error': {
                    'code': 'INVALID_NAME',
                    'message': 'Invalid skill name'
                }
            }

        # Determine target directory based on location parameter
        # Default: project skills (.deepagents/skills/)
        # Optional: user skills (~/.deepagents/skills/)
        location = params.get('location', 'project')  # 'project' or 'user'

        if location == 'user':
            # User skills directory: ~/.deepagents/skills/
            target_dir = Path.home() / '.deepagents' / 'skills' / skill_name
        else:
            # Project skills directory: .deepagents/skills/ (default)
            # Search upward for project root (up to 10 levels)
            search_path = Path.cwd()
            project_root = None
            for _ in range(10):
                if (search_path / '.deepagents').exists():
                    project_root = search_path
                    break
                search_path = search_path.parent

            if project_root:
                target_dir = project_root / '.deepagents' / 'skills' / skill_name
            else:
                # Fallback to user skills if project root not found
                target_dir = Path.home() / '.deepagents' / 'skills' / skill_name

        try:
            # Create target directory if it doesn't exist
            target_dir.mkdir(parents=True, exist_ok=True)

            # Debug: log what files we received
            log_file.write(f"Upload skill '{skill_name}' with {len(files)} files (base64 mode)\n")
            log_file.flush()

            # Write each file from base64 content
            written_count = 0
            for file_info in files:
                file_name = file_info.get('name', '')
                content_b64 = file_info.get('content', '')
                mime_type = file_info.get('mimeType', 'text/plain')

                # Skip invalid entries
                if not file_name or file_name in ('.', ''):
                    continue

                if not content_b64:
                    log_file.write(f"  Skipping {file_name}: no content\n")
                    log_file.flush()
                    continue

                try:
                    # Decode base64 content
                    content_bytes = base64.b64decode(content_b64, validate=True)

                    # Write to file
                    target_file = target_dir / file_name
                    target_file.write_bytes(content_bytes)
                    written_count += 1

                    log_file.write(f"  Written: {file_name} ({len(content_bytes)} bytes, type: {mime_type})\n")
                    log_file.flush()

                except (binascii.Error, ValueError) as e:
                    log_file.write(f"  Failed to decode {file_name}: {e}\n")
                    log_file.flush()
                    continue

            log_file.write(f"Total written: {written_count}\n")
            log_file.flush()

            if written_count == 0:
                return {
                    'request_id': request_id,
                    'status': 'error',
                    'error': {
                        'code': 'NO_FILES',
                        'message': 'No valid files were written'
                    }
                }

            return {
                'request_id': request_id,
                'status': 'success',
                'data': {
                    'message': f'Successfully wrote {written_count} files to {target_dir}',
                    'skill_name': skill_name,
                    'target_path': str(target_dir),
                    'location': location,
                    'files_written': written_count
                }
            }
        except Exception as e:
            log_file.write(f"Upload failed: {e}\n")
            log_file.flush()
            return {
                'request_id': request_id,
                'status': 'error',
                'error': {
                    'code': 'UPLOAD_FAILED',
                    'message': str(e)
                }
            }

    def _extract_content(self, content: Any) -> str:
        """Extract string content from message content.

        Args:
            content: Message content (str, list, or other)

        Returns:
            String representation of content
        """
        if isinstance(content, str):
            return content
        elif isinstance(content, list):
            # Handle list of content blocks
            result = []
            for item in content:
                if isinstance(item, str):
                    result.append(item)
                elif isinstance(item, dict):
                    # Handle structured content blocks
                    if 'text' in item:
                        result.append(item['text'])
                    elif 'type' in item and item['type'] == 'text':
                        result.append(item.get('text', ''))
                    else:
                        result.append(str(item))
                else:
                    result.append(str(item))
            return ''.join(result)
        else:
            return str(content)

    async def _handle_chat(self, request_id: str, params: dict[str, Any], session_state: dict[str, Any]) -> dict[str, Any]:
        """Handle chat request with HITL support.

        Args:
            request_id: Request identifier for response correlation
            params: Chat parameters including message and stream flag
            session_state: Session state for this connection

        Returns:
            Response with AI content, or interrupt_request if waiting for user approval
        """
        if self.agent is None:
            return {
                'request_id': request_id,
                'status': 'error',
                'error': {
                    'code': 'AGENT_NOT_READY',
                    'message': 'Agent not initialized'
                }
            }

        user_message = params.get('message', '')
        stream = params.get('stream', False)

        # Log file for this session
        log_file = open(Path.home() / 'deepagents-desktop-python.log', 'a')

        try:
            # Config for checkpointer (thread_id for conversation memory)
            config = {"configurable": {"thread_id": session_state['thread_id']}}
            session_state['status'] = 'processing'
            session_state['current_request_id'] = request_id

            log_file.write(f"[_handle_chat] Processing message, stream={stream}, user_message='{user_message[:100] if len(user_message) > 100 else user_message}'\n")
            log_file.flush()

            # Invoke agent
            if stream:
                # Streaming response with interrupt detection
                content = ""
                chunk_count = 0
                log_file.write(f"[_handle_chat] Starting stream iteration...\n")
                log_file.flush()

                async for chunk in self.agent.astream({'messages': [user_message]}, config):
                    chunk_count += 1
                    chunk_type = type(chunk).__name__
                    log_file.write(f"[_handle_chat] Chunk {chunk_count}: type={chunk_type}, keys={list(chunk.keys()) if isinstance(chunk, dict) else 'N/A'}\n")

                    # Check for interrupt state
                    if self._check_for_interrupt(chunk):
                        log_file.write(f"[_handle_chat] Interrupt detected!\n")
                        # Log the interrupt chunk structure for debugging
                        log_file.write(f"[_handle_chat] Interrupt chunk: {str(chunk)[:1000]}\n")
                        log_file.flush()

                        # Save config and original request_id for resume
                        # The original request_id is the chat request that triggered the tool call
                        # Create an event to wait for user approval
                        approval_event = asyncio.Event()
                        approval_result = {'action': None}  # Will store 'approve' or 'reject'

                        session_state['pending_interrupt'] = {
                            'config': config,
                            'original_request_id': request_id,  # The chat request
                            'tool_approval_request_id': None,  # Will be set when approval is requested
                            'approval_event': approval_event,
                            'approval_result': approval_result
                        }
                        session_state['status'] = 'waiting_approval'

                        # Send interrupt request to frontend
                        tool_info = self._extract_tool_info(chunk, log_file)
                        await self._send_interrupt_request(session_state, request_id, tool_info, log_file)

                        # Wait for user approval (with timeout)
                        log_file.write(f"[_handle_chat] Waiting for user approval...\n")
                        log_file.flush()

                        try:
                            await asyncio.wait_for(approval_event.wait(), timeout=300.0)  # 5 minutes timeout
                            action = approval_result['action']
                            log_file.write(f"[_handle_chat] User approved: {action}\n")
                            log_file.flush()

                            if action == 'reject':
                                # User rejected - return error response
                                return {
                                    'request_id': request_id,
                                    'status': 'success',
                                    'data': {'content': '工具执行已取消', 'rejected': True}
                                }

                            # User approved - execute tool and return result
                            resume_command = Command(resume={"decisions": [{"type": "approve"}]})
                            result = await self.agent.ainvoke(resume_command, config)

                            # Extract content from result
                            content = ""
                            if 'messages' in result:
                                for msg in result['messages']:
                                    msg_type = type(msg).__name__
                                    if msg_type == 'AIMessage':
                                        if hasattr(msg, 'content'):
                                            extracted = self._extract_content(msg.content)
                                            if extracted:
                                                content += extracted
                                    elif isinstance(msg, dict) and 'content' in msg:
                                        extracted = self._extract_content(msg['content'])
                                        content += extracted

                            log_file.write(f"[_handle_chat] Tool execution complete, {len(content)} chars\n")
                            log_file.flush()

                            return {
                                'request_id': request_id,
                                'status': 'success',
                                'data': {'content': content}
                            }

                        except asyncio.TimeoutError:
                            log_file.write(f"[_handle_chat] Approval timeout\n")
                            log_file.flush()
                            return {
                                'request_id': request_id,
                                'status': 'error',
                                'error': {
                                    'code': 'TIMEOUT',
                                    'message': '等待用户批准超时'
                                }
                            }

                    # Extract content from chunk
                    # Content can be in various locations:
                    # 1. Direct 'messages' key
                    # 2. Nested under middleware keys like {'middleware_name': {'messages': [...]}}
                    # 3. Special response chunks
                    messages_to_process = []

                    if isinstance(chunk, dict):
                        # Check for direct 'messages' key
                        if 'messages' in chunk:
                            messages_to_process = chunk['messages']
                        else:
                            # Check nested under middleware keys
                            for key, value in chunk.items():
                                if isinstance(value, dict) and 'messages' in value:
                                    messages_to_process = value['messages']
                                    break

                    if messages_to_process:
                        # Handle Overwrite type from LangChain
                        if type(messages_to_process).__name__ == 'Overwrite':
                            messages_list = messages_to_process.value
                        else:
                            messages_list = messages_to_process

                        log_file.write(f"[_handle_chat] Found {len(messages_list)} messages to process\n")
                        for msg in messages_list:
                            # Check if this is an AI response (not user message)
                            msg_type = type(msg).__name__
                            log_file.write(f"[_handle_chat] Processing message type: {msg_type}\n")

                            # Only extract AI assistant responses, not user messages
                            if msg_type == 'AIMessage':
                                if hasattr(msg, 'content'):
                                    extracted = self._extract_content(msg.content)
                                    if extracted:
                                        content += extracted
                                        log_file.write(f"[_handle_chat] Extracted {len(extracted)} chars from AIMessage\n")
                                elif isinstance(msg, dict) and 'content' in msg:
                                    extracted = self._extract_content(msg['content'])
                                    content += extracted
                    else:
                        # Log chunk content for debugging
                        if chunk_count <= 3:  # Only log first 3 chunks to avoid spam
                            log_file.write(f"[_handle_chat] Chunk preview: {str(chunk)[:200]}\n")

                    log_file.flush()

                log_file.write(f"[_handle_chat] Stream complete: {chunk_count} chunks, {len(content)} chars total\n")
                log_file.flush()

                session_state['status'] = 'idle'
                return {
                    'request_id': request_id,
                    'status': 'success',
                    'data': {'content': content}
                }
            else:
                # Single response with interrupt detection
                response = await self.agent.ainvoke({'messages': [user_message]}, config)
                content = ""
                if 'messages' in response:
                    for msg in response['messages']:
                        if hasattr(msg, 'content'):
                            content += self._extract_content(msg.content)
                        elif isinstance(msg, dict) and 'content' in msg:
                            content += self._extract_content(msg['content'])

                session_state['status'] = 'idle'
                return {
                    'request_id': request_id,
                    'status': 'success',
                    'data': {'content': content}
                }
        except Exception as e:
            log_file.write(f"[_handle_chat] Error: {e}\n")
            log_file.flush()
            session_state['status'] = 'idle'
            return {
                'request_id': request_id,
                'status': 'error',
                'error': {
                    'code': 'AGENT_ERROR',
                    'message': str(e)
                }
            }
        finally:
            log_file.close()

    async def stop(self) -> None:
        """Stop the protocol and cleanup resources."""
        self.running = False

    # === HITL Helper Methods ===

    def _check_for_interrupt(self, chunk: dict[str, Any]) -> bool:
        """Check if the chunk contains an interrupt signal.

        Args:
            chunk: Stream chunk from agent

        Returns:
            True if this is an interrupt, False otherwise
        """
        # Check for NodeInterrupt or special interrupt markers
        if isinstance(chunk, dict):
            # Check for __interrupt__ key (LangGraph interrupt marker)
            if '__interrupt__' in chunk:
                return True
            # Check for special states
            if 'nodes' in chunk and '__end__' not in chunk:
                # Check if any node is in interrupt state
                for node_name, node_data in chunk.get('nodes', {}).items():
                    if isinstance(node_data, dict) and '__error__' in node_data:
                        return True
        return False

    def _extract_tool_info(self, chunk: dict[str, Any], log_file) -> dict[str, Any]:
        """Extract tool call information from interrupt chunk.

        Args:
            chunk: Stream chunk containing interrupt
            log_file: Log file handle for debugging

        Returns:
            Dictionary with tool information
        """
        try:
            log_file.write(f"[_extract_tool_info] Analyzing chunk structure...\n")
            log_file.flush()

            # The interrupt chunk has structure like:
            # {'__interrupt__': (Interrupt(value={'action_requests': [...]}),)}
            # or
            # {'__interrupt__': Interrupt(value={'action_requests': [...]})}

            if '__interrupt__' in chunk:
                interrupt_value = chunk['__interrupt__']
                log_file.write(f"[_extract_tool_info] Found __interrupt__: {type(interrupt_value).__name__}\n")
                log_file.flush()

                # Handle tuple wrapping
                if isinstance(interrupt_value, tuple) and len(interrupt_value) > 0:
                    interrupt_value = interrupt_value[0]

                # Check if it has 'value' attribute (Interrupt object)
                if hasattr(interrupt_value, 'value'):
                    value_dict = interrupt_value.value
                    log_file.write(f"[_extract_tool_info] Interrupt value keys: {list(value_dict.keys()) if isinstance(value_dict, dict) else 'N/A'}\n")
                    log_file.flush()

                    if isinstance(value_dict, dict) and 'action_requests' in value_dict:
                        action_requests = value_dict['action_requests']
                        if action_requests and len(action_requests) > 0:
                            action = action_requests[0]
                            tool_name = action.get('name', 'unknown_tool')
                            tool_args = action.get('args', {})
                            description = action.get('description', '')

                            log_file.write(f"[_extract_tool_info] Tool: {tool_name}, Args: {str(tool_args)[:200]}\n")
                            log_file.flush()

                            return {
                                'name': tool_name,
                                'input': tool_args,
                                'message': f'Agent 即将执行工具: {tool_name}\n{description}'
                            }

        except Exception as e:
            log_file.write(f"[_extract_tool_info] Error: {e}\n")
            log_file.flush()

        # Default tool info
        return {
            'name': 'unknown_tool',
            'input': {},
            'message': 'Agent 请求执行工具操作'
        }

    async def _send_interrupt_request(self, session_state: dict[str, Any], request_id: str,
                                      tool_info: dict[str, Any], log_file) -> None:
        """Send interrupt request to frontend.

        Args:
            session_state: Current session state
            request_id: Original request ID
            tool_info: Tool call information
            log_file: Log file handle
        """
        try:
            interrupt_msg = {
                'type': 'interrupt_request',
                'request_id': request_id,
                'data': {
                    'thread_id': session_state['thread_id'],
                    'tool_name': tool_info.get('name', 'unknown'),
                    'tool_input': tool_info.get('input', {}),
                    'message': f"Agent 即将执行工具: {tool_info.get('name', 'unknown')}"
                }
            }

            # Send via session writer
            writer = session_state['writer']
            msg_data = msgpack.packb(interrupt_msg)
            msg_length = len(msg_data).to_bytes(4, 'little')
            writer.write(msg_length + msg_data)
            await writer.drain()

            log_file.write(f"[_send_interrupt_request] Sent interrupt request for {tool_info.get('name')}\n")
            log_file.flush()
        except Exception as e:
            log_file.write(f"[_send_interrupt_request] Error: {e}\n")
            log_file.flush()

    async def _handle_tool_approval(self, tool_approval_request_id: str, params: dict[str, Any],
                                   session_state: dict[str, Any]) -> dict[str, Any] | None:
        """Handle user's tool approval decision.

        Args:
            tool_approval_request_id: Tool approval request ID
            params: Approval params with 'action' ('approve' or 'reject')
            session_state: Session state

        Returns:
            None (response is sent to the original chat request, not this approval request)
        """
        log_file = open(Path.home() / 'deepagents-desktop-python.log', 'a')

        try:
            action = params.get('action', 'reject')
            log_file.write(f"[_handle_tool_approval] Received: {action} for request_id: {tool_approval_request_id}\n")
            log_file.flush()

            # Save tool_approval request_id and trigger approval event
            if session_state.get('pending_interrupt'):
                session_state['pending_interrupt']['tool_approval_request_id'] = tool_approval_request_id
                original_request_id = session_state['pending_interrupt']['original_request_id']
                log_file.write(f"[_handle_tool_approval] Triggering approval for original chat request: {original_request_id}\n")
                log_file.flush()

                # Set approval result and trigger event
                session_state['pending_interrupt']['approval_result']['action'] = action
                session_state['pending_interrupt']['approval_event'].set()

                # Return None (the response will be sent by _handle_chat after tool execution)
                return None
            else:
                log_file.write(f"[_handle_tool_approval] No pending interrupt found\n")
                log_file.flush()
                return None

        except Exception as e:
            log_file.write(f"[_handle_tool_approval] Error: {e}\n")
            log_file.flush()
            return None
                        'request_id': original_request_id,
                        'status': 'error',
                        'error': {
                            'code': 'RESUME_ERROR',
                            'message': str(e)
                        }
                    }

            return {
                'request_id': request_id,
                'status': 'error',
                'error': {
                    'code': 'INVALID_STATE',
                    'message': 'No pending interrupt to approve'
                }
            }

        except Exception as e:
            log_file.write(f"[_handle_tool_approval] Error: {e}\n")
            log_file.flush()
            session_state['status'] = 'idle'
            return {
                'request_id': request_id,
                'status': 'error',
                'error': {
                    'code': 'APPROVAL_ERROR',
                    'message': str(e)
                }
            }
        finally:
            log_file.close()
